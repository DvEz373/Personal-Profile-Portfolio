---
/** Section title with a hairline rule and an optional one-line note. */
interface Props {
  title: string;
  note?: string;
  id?: string;
}
const { title, note, id } = Astro.props;
---

<div class="section-head">
  <h2 id={id}>{title}</h2>
  <span class="rule" aria-hidden="true"></span>
  {note && <p class="note">{note}</p>}
</div>
