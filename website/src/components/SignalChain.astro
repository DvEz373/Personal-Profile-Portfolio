---
/**
 * Background → current work → direction, drawn as a control-loop block diagram:
 * three blocks in series with a feedback path from the last back to the first.
 */
interface Props {
  chain: { stage: string; label: string; items: string[] }[];
}
const { chain } = Astro.props;
const tones = ["c-leaf", "c-sun", "c-signal"];
---

<div class="loop">
  <ol class="blocks">
    {
      chain.map((block, i) => (
        <li class:list={["block", tones[i]]}>
          <p class="stage mono">
            <span class="n">{String(i + 1).padStart(2, "0")}</span> {block.stage}
          </p>
          <h3>{block.label}</h3>
          <ul class="items">
            {block.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
  <div class="feedback" aria-hidden="true">
    <span class="mono">feedback · keep learning</span>
  </div>
</div>

<style>
  .loop {
    position: relative;
  }
  .blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    position: relative;
    z-index: 1;
  }
  .block {
    position: relative;
    padding: 20px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--c);
    border-radius: var(--radius);
    background: var(--panel);
  }
  /* forward arrow to the next block */
  .block:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -48px;
    width: 48px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--ink-2) 0 6px, transparent 6px 10px);
  }
  .block:not(:last-child)::before {
    content: "";
    position: absolute;
    top: calc(50% - 5px);
    right: -50px;
    border: 6px solid transparent;
    border-left: 9px solid var(--ink-2);
    border-right: 0;
  }
  .stage {
    margin: 0 0 6px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  .stage .n {
    color: var(--ink-2);
  }
  h3 {
    font-family: var(--font-serif), Georgia, serif;
    font-weight: 400;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .items li {
    font-size: 0.88rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--c-soft);
    color: var(--ink);
  }
  .feedback {
    position: relative;
    margin: 0 calc(100% / 6) 0;
    height: 44px;
    border: 2px dashed var(--line-strong);
    border-top: 0;
    border-radius: 0 0 14px 14px;
  }
  .feedback span {
    position: absolute;
    left: 50%;
    bottom: -10px;
    translate: -50% 0;
    padding: 0 10px;
    background: var(--paper);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  @media (max-width: 859px) {
    .blocks {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .block:not(:last-child)::after {
      top: auto;
      bottom: -32px;
      right: auto;
      left: 32px;
      width: 2px;
      height: 32px;
      background: repeating-linear-gradient(180deg, var(--ink-2) 0 6px, transparent 6px 10px);
    }
    .block:not(:last-child)::before {
      top: auto;
      bottom: -34px;
      right: auto;
      left: 27px;
      border: 6px solid transparent;
      border-top: 9px solid var(--ink-2);
      border-bottom: 0;
    }
    .feedback {
      display: none;
    }
  }
</style>
