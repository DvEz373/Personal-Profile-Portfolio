---
import type { CollectionEntry } from "astro:content";
import ProjectCover from "./ProjectCover.astro";
import { CATEGORY_LABEL } from "../lib/content";
import { formatRange } from "../lib/dates";
import { url } from "../lib/url";

/**
 * One project as a card with its cover figure; used on Projects and in Home's "Selected work".
 * The title is an h3 holding the only link; its ::after stretches over the card, so the whole card
 * stays clickable while the link's name is just the title (the rest is read as plain text).
 */
interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const p = entry.data;
---

<article class="card">
  <span class="fig" transition:name={`fig-${entry.id}`}>
    <ProjectCover id={entry.id} category={p.category} figure={p.figures[0]} focus={p.coverFocus} zoom={p.coverZoom} decorative sizes="(min-width: 1240px) 380px, (min-width: 760px) 50vw, 100vw" />
  </span>
  <div class="body">
    <h3 class="title" transition:name={`title-${entry.id}`}>
      <a href={url(`projects/${entry.id}/`)}>{p.title}</a>
    </h3>
    <!-- After the title in reading order, above it on screen. -->
    <p class="meta mono">
      <span class="cat">{CATEGORY_LABEL[p.category]}</span>
      <span>{formatRange(p.start, p.end)}</span>
    </p>
    <p class="blurb">{p.blurb}</p>
    <ul class="stack">
      {p.stack.slice(0, 4).map((s) => <li class="tag">{s}</li>)}
    </ul>
    <span class="go mono" aria-hidden="true">Read the case study →</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--panel);
    color: var(--ink);
    transition:
      border-color var(--t-ui) var(--ease),
      transform var(--t-ui) var(--ease),
      box-shadow var(--t-ui) var(--ease);
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--c);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    --play: running;
  }
  .card:active {
    transform: translateY(-2px);
  }
  .fig {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden; /* keeps tall figures from stretching the 16:9 box, and rounds the top corners */
    border-bottom: 1px solid var(--line);
    border-radius: calc(var(--radius-l) - 1px) calc(var(--radius-l) - 1px) 0 0;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
  }
  .meta {
    order: -1;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-2);
  }
  .cat {
    color: var(--c-ink);
  }
  .title {
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  /* The link covers the whole card. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
  }
  /* The focus ring goes round the card, drawn by the stretched area, not round the title text. */
  .title a:focus-visible {
    outline: none;
  }
  .title a:focus-visible::after {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .blurb {
    margin: 0;
    color: var(--ink-2);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .go {
    margin-top: auto;
    padding-top: 10px;
    font-size: 0.8rem;
    color: var(--signal);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within,
    .card:active {
      transform: none;
    }
  }
</style>
