---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

/** Optimised photo (AVIF + WebP, several widths) inside an annotated frame. */
interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  caption?: string;
  label?: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
  transitionName?: string;
}
const { src, alt, widths, sizes, caption, label, ratio, eager = false, class: cls, transitionName } = Astro.props;
---

<figure class:list={["photo", cls]} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <div class="frame" transition:name={transitionName}>
    <Picture
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      widths={widths}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
    {label && <span class="tag-label mono" aria-hidden="true">{label}</span>}
    <slot name="overlay" />
  </div>
  {caption && <figcaption class="fig-label">{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--panel-2);
    aspect-ratio: var(--ratio, auto);
  }
  .frame :global(picture),
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tag-label {
    position: absolute;
    left: 10px;
    top: 10px;
    padding: 3px 7px;
    border-radius: 4px;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    background: rgb(12 15 20 / 0.62);
    color: #fff;
    backdrop-filter: blur(4px);
  }
  figcaption {
    margin-top: 10px;
  }
</style>
