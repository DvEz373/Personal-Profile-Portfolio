---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectArt from "./ProjectArt.astro";

/**
 * A project's cover: its first real figure, shown whole on a white sheet (engineering
 * diagrams are drawn for white paper, in both themes). Projects without figures fall
 * back to the generated line illustration.
 */
interface Props {
  id: string;
  category: "energy" | "ai" | "iot";
  figure?: { src: ImageMetadata; alt: string };
  /** Card thumbnails are decorative (the card's title names the link); headers describe the figure. */
  decorative?: boolean;
  sizes: string;
  eager?: boolean;
  /** Crop for card thumbnails: CSS object-position and zoom. Without either, the whole figure shows. */
  focus?: string;
  zoom?: number;
}
const { id, category, figure, decorative = false, sizes, eager = false, focus, zoom } = Astro.props;
const cropped = Boolean(focus || zoom);
const crop = cropped ? `--focus: ${focus ?? "50% 50%"}; --zoom: ${zoom ?? 1}` : undefined;
---

{
  figure ? (
    <div class:list={["cover", { cropped }]} style={crop}>
      <Picture
        src={figure.src}
        alt={decorative ? "" : figure.alt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600].filter((w) => w <= figure.src.width)}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
      />
    </div>
  ) : (
    <ProjectArt id={id} category={category} fig="" />
  )
}

<style>
  .cover {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(10px, 3%, 20px);
    background: #fff;
  }
  .cover :global(picture),
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cover :global(img) {
    object-fit: contain;
  }
  /* A cropped card shows one readable region of a dense diagram instead of the whole sheet. */
  .cover.cropped {
    padding: 0;
    overflow: hidden;
  }
  .cover.cropped :global(img) {
    object-fit: cover;
    object-position: var(--focus);
    transform: scale(var(--zoom));
    transform-origin: var(--focus);
  }
</style>
