---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectArt from "./ProjectArt.astro";

/**
 * A project's cover: its first real figure, shown whole on a white sheet (engineering
 * diagrams are drawn for white paper, in both themes). Projects without figures fall
 * back to the generated line illustration.
 */
interface Props {
  id: string;
  category: "energy" | "ai" | "iot";
  figure?: { src: ImageMetadata; alt: string };
  /** Card thumbnails are decorative (the card's title names the link); headers describe the figure. */
  decorative?: boolean;
  sizes: string;
  eager?: boolean;
}
const { id, category, figure, decorative = false, sizes, eager = false } = Astro.props;
---

{
  figure ? (
    <div class="cover">
      <Picture
        src={figure.src}
        alt={decorative ? "" : figure.alt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600].filter((w) => w <= figure.src.width)}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
      />
    </div>
  ) : (
    <ProjectArt id={id} category={category} fig="" />
  )
}

<style>
  .cover {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(10px, 3%, 20px);
    background: #fff;
  }
  .cover :global(picture),
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cover :global(img) {
    object-fit: contain;
  }
</style>
