---
import Photo from "./Photo.astro";
import { url } from "../lib/url";
import type { ImageMetadata } from "astro";

export interface TimelineItem {
  id: string;
  type: string;
  typeLabel: string;
  tone: string;
  dateLabel: string;
  duration: string;
  title: string;
  sub: string;
  summary: string;
  points: string[];
  tags: string[];
  callout?: { label: string; text: string };
  link?: { href: string; label: string };
  photo?: { src: ImageMetadata; alt: string };
}
interface Props {
  items: TimelineItem[];
  filters: { key: string; label: string; tone: string }[];
  label: string;
}
const { items, filters, label } = Astro.props;
const count = (key: string) => items.filter((i) => i.type === key).length;
---

<div class="timeline" data-filterable>
  <div class="bar">
    <div class="chips" role="group" aria-label={`Filter ${label} by type`}>
      <button class="chip" type="button" data-filter="all" aria-pressed="true">All<span class="count">{items.length}</span></button>
      {
        filters.map((f) => (
          <button class:list={["chip", f.tone]} type="button" data-filter={f.key} aria-pressed="false">
            <i class="dot" aria-hidden="true" />
            {f.label}
            <span class="count">{count(f.key)}</span>
          </button>
        ))
      }
    </div>
    <p class="label" aria-live="polite" data-shown>Showing {items.length} of {items.length}</p>
  </div>

  <ol class="list" aria-label={label}>
    {
      items.map((it, i) => (
        <li id={it.id} class:list={["item", it.tone]} data-kind={it.type}>
          <span class="rail" aria-hidden="true">
            <span class="node" />
          </span>
          <details class="card" open={i === 0}>
            <summary>
              <span class="meta mono">
                <span class="when">{it.dateLabel}</span>
                <span class="dur">{it.duration}</span>
                <span class="type">{it.typeLabel}</span>
              </span>
              <h3>{it.title}</h3>
              <span class="sub">{it.sub}</span>
              <span class="sum">{it.summary}</span>
              <span class="toggle" aria-hidden="true" />
            </summary>
            <div class="body">
              {it.callout && (
                <div class="callout">
                  <span class="label">{it.callout.label}</span>
                  <p>{it.callout.text}</p>
                </div>
              )}
              {it.points.length > 0 && (
                <ul class="points">
                  {it.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
              {it.photo && (
                <div class="photo">
                  <Photo src={it.photo.src} alt={it.photo.alt} widths={[320, 480, 640]} sizes="(min-width: 640px) 320px, 80vw" ratio="4 / 5"  />
                </div>
              )}
              {it.tags.length > 0 && (
                <ul class="tags">
                  {it.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              )}
              {it.link && (
                <a class="more" href={url(it.link.href)}>
                  {it.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-bottom: 28px;
  }
  .bar .label {
    margin: 0;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .item[hidden] {
    display: none;
  }
  .rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -14px;
    width: 2px;
    background: var(--line);
  }
  .item:last-child .rail::before {
    bottom: auto;
    height: 30px;
  }
  .node {
    position: relative;
    margin-top: 22px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--c);
    transition: transform var(--t-ui) var(--ease-settle);
  }
  .card {
    margin-bottom: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    transition: border-color var(--t-ui) var(--ease), box-shadow var(--t-ui) var(--ease);
  }
  .item[data-hot] .card,
  .item:target .card {
    border-color: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 22%, transparent);
  }
  .item[data-hot] .node,
  .item:target .node {
    transform: scale(1.35);
  }
  summary {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 16px 56px 16px 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 0.76rem;
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  .type {
    color: var(--c-ink);
  }
  .dur::before,
  .type::before {
    content: "·";
    margin-right: 12px;
    color: var(--line-strong);
  }
  h3 {
    font-size: 1.12rem;
  }
  .sub {
    color: var(--ink-2);
    font-size: 0.93rem;
  }
  .sum {
    margin-top: 6px;
  }
  .toggle {
    position: absolute;
    right: 16px;
    top: 18px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform var(--t-ui) var(--ease), border-color var(--t-ui) var(--ease);
  }
  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    background: var(--ink-2);
    translate: -50% -50%;
  }
  .toggle::after {
    rotate: 90deg;
  }
  details[open] .toggle {
    transform: rotate(45deg);
    border-color: var(--c);
  }
  summary:hover .toggle {
    border-color: var(--c);
  }
  .body {
    padding: 4px 18px 18px;
    border-top: 1px dashed var(--line);
    display: grid;
    gap: 14px;
  }
  .points {
    margin: 12px 0 0;
    padding-left: 20px;
  }
  .points li {
    margin: 6px 0;
  }
  .points li::marker {
    color: var(--c);
  }
  .callout {
    margin-top: 14px;
    padding: 12px 14px;
    border-left: 3px solid var(--c);
    background: var(--c-soft);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .callout p {
    margin: 4px 0 0;
    font-family: var(--font-sans), system-ui, sans-serif;
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .photo {
    max-width: 300px;
  }
  .more {
    font-weight: 550;
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  @media (max-width: 559px) {
    .item {
      grid-template-columns: 18px 1fr;
      gap: 10px;
    }
    summary {
      padding: 14px 50px 14px 14px;
    }
    .body {
      padding: 4px 14px 16px;
    }
  }
</style>

<script>
  import { initFilterablePage } from "../scripts/filters";
  document.addEventListener("astro:page-load", initFilterablePage);
</script>
