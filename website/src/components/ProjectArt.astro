---
/**
 * Generated line illustration for a project, drawn from its category and seeded by
 * its id so it is stable between builds. Used until real figures are added.
 */
interface Props {
  id: string;
  category: "energy" | "ai" | "iot";
  fig: string;
  class?: string;
}
const { id, category, fig, class: cls } = Astro.props;

function rng(seedText: string) {
  let h = 2166136261;
  for (const ch of seedText) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  let a = h >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(id);
const W = 400;
const H = 225;
const tone = { energy: "sun", ai: "signal", iot: "leaf" }[category];

// ai: layered network
const layers = [3, 5, 5, 2].map((n, li, all) => Array.from({ length: n }, (_, i) => ({ x: 70 + (li * (W - 140)) / (all.length - 1), y: H / 2 + (i - (n - 1) / 2) * 34 })));
const links = layers.slice(0, -1).flatMap((layer, li) => layer.flatMap((a) => layers[li + 1].filter(() => r() > 0.35).map((b) => ({ a, b }))));
const path = layers.map((layer) => layer[Math.floor(r() * layer.length)]);

// iot: sensor mesh around a gateway
const nodes = Array.from({ length: 11 }, () => ({ x: 40 + r() * (W - 80), y: 30 + r() * (H - 60) }));
const gateway = { x: W * (0.45 + r() * 0.1), y: H * (0.45 + r() * 0.1) };
const meshEdges = nodes.flatMap((n, i) =>
  nodes
    .map((m, j) => ({ m, j, d: Math.hypot(n.x - m.x, n.y - m.y) }))
    .filter((e) => e.j > i)
    .sort((a, b) => a.d - b.d)
    .slice(0, 2)
    .map((e) => ({ a: n, b: e.m })),
);

// energy: three-phase waves + phasors
const phase = r() * Math.PI * 2;
const wave = (k: number) =>
  Array.from({ length: 61 }, (_, i) => {
    const x = 30 + (i / 60) * 220;
    const y = H / 2 - Math.sin((i / 60) * Math.PI * 4 + phase - (k * 2 * Math.PI) / 3) * 52;
    return `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`;
  }).join(" ");
const phasor = (k: number) => {
  const a = phase - (k * 2 * Math.PI) / 3 - Math.PI / 2;
  return { x: 320 + Math.cos(a) * 52, y: H / 2 + Math.sin(a) * 52 };
};
---

<svg class:list={["art", tone, cls]} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Illustration for ${category === "ai" ? "an AI" : category === "iot" ? "an IoT" : "an energy"} project`} preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`g-${id}`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-opacity="0.08" stroke-width="1"></path>
    </pattern>
  </defs>
  <rect width={W} height={H} class="bg"></rect>
  <rect width={W} height={H} fill={`url(#g-${id})`}></rect>

  {
    category === "ai" && (
      <g>
        {links.map((l) => (
          <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} class="faint" />
        ))}
        <polyline points={path.map((p) => `${p.x},${p.y}`).join(" ")} class="hot" />
        {layers.flat().map((n) => (
          <circle cx={n.x} cy={n.y} r="7" class="node" />
        ))}
      </g>
    )
  }
  {
    category === "iot" && (
      <g>
        {meshEdges.map((e) => (
          <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} class="faint" />
        ))}
        {nodes.slice(0, 4).map((n) => (
          <line x1={n.x} y1={n.y} x2={gateway.x} y2={gateway.y} class="hot" />
        ))}
        <circle cx={gateway.x} cy={gateway.y} r="22" class="ring" />
        <circle cx={gateway.x} cy={gateway.y} r="38" class="ring r2" />
        {nodes.map((n) => (
          <circle cx={n.x} cy={n.y} r="5" class="node" />
        ))}
        <rect x={gateway.x - 9} y={gateway.y - 9} width="18" height="18" rx="3" class="node solid" />
      </g>
    )
  }
  {
    category === "energy" && (
      <g>
        <line x1="30" y1={H / 2} x2="250" y2={H / 2} class="faint" />
        {[0, 1, 2].map((k) => (
          <path d={wave(k)} class={`ph p${k}`} />
        ))}
        <circle cx="320" cy={H / 2} r="52" class="faint" />
        {[0, 1, 2].map((k) => {
          const p = phasor(k);
          return <line x1="320" y1={H / 2} x2={p.x} y2={p.y} class={`ph p${k}`} />;
        })}
        <circle cx="320" cy={H / 2} r="4" class="node solid" />
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
  .sun {
    --tone: var(--sun);
  }
  .signal {
    --tone: var(--signal);
  }
  .leaf {
    --tone: var(--leaf);
  }
  .bg {
    fill: color-mix(in srgb, var(--tone) 9%, var(--panel));
  }
  .faint {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }
  .hot {
    fill: none;
    stroke: var(--tone);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 6 6;
  }
  .node {
    fill: var(--panel);
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .node.solid {
    fill: var(--tone);
    stroke: none;
  }
  .ring {
    fill: none;
    stroke: var(--tone);
    stroke-width: 1.4;
    opacity: 0.5;
  }
  .ring.r2 {
    opacity: 0.25;
  }
  .ph {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .p0 {
    stroke: var(--sun);
  }
  .p1 {
    stroke: var(--signal);
  }
  .p2 {
    stroke: var(--leaf);
  }
  .fig {
    font-family: var(--font-sans), system-ui, sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--ink-2);
  }
  .fig.small {
    font-size: 9px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hot {
      animation: dash 1.8s linear infinite;
      animation-play-state: var(--play, paused);
    }
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -24;
    }
  }
</style>
