---
/**
 * Section links drawn as a single-line diagram: a generator feeds a bus bar,
 * and each page hangs off the bus on its own feeder with a circuit breaker.
 * Hover or focus a feeder: its breaker closes and current flows to it.
 * Semantically it is a plain list of links.
 */
interface Feeder {
  href: string;
  idx: string;
  title: string;
  line: string;
  meta: string;
}
interface Props {
  feeders: Feeder[];
  source: string;
}
const { feeders, source } = Astro.props;
---

<nav class="sld" aria-label="Sections">
  <div class="source" aria-hidden="true">
    <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="20"></circle><path d="M12 24c3-8 6-8 9 0s6 8 9 0 6-8 7-3"></path></svg>
    <span class="mono">{source}</span>
  </div>
  <div class="bus" aria-hidden="true"></div>
  <ul>
    {
      feeders.map((f) => (
        <li>
          <a href={f.href} class="feeder">
            <span class="drop" aria-hidden="true">
              <span class="breaker">
                <i />
              </span>
            </span>
            <span class="card">
              <span class="idx mono">{f.idx}</span>
              <span class="title">{f.title}</span>
              <span class="line">{f.line}</span>
              <span class="meta mono">
                {f.meta}
                <span class="arrow">→</span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .sld {
    --bus: var(--ink);
    --feed: var(--line-strong);
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
  }
  .source {
    grid-row: 1;
    grid-column: 1;
    position: relative;
    padding-right: 14px;
  }
  .source svg {
    width: 48px;
    height: 48px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .source path {
    stroke: var(--signal);
  }
  .source span {
    position: absolute;
    left: 56px;
    bottom: calc(100% - 14px);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .bus {
    grid-row: 1;
    grid-column: 2;
    align-self: center;
    height: 4px;
    border-radius: 2px;
    background: var(--bus);
  }
  ul {
    grid-row: 2;
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    padding-left: 62px;
  }
  .feeder {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
  }
  .drop {
    position: relative;
    display: flex;
    justify-content: flex-start;
    height: 56px;
    margin-left: 22px;
    border-left: 2px solid var(--feed);
    margin-top: -26px;
    transition: border-color var(--t-ui) var(--ease);
  }
  .drop::before {
    /* current flowing down the feeder */
    content: "";
    position: absolute;
    left: -2px;
    top: 0;
    width: 2px;
    height: 100%;
    background: repeating-linear-gradient(to bottom, var(--sun) 0 6px, transparent 6px 14px);
    opacity: 0;
    transition: opacity var(--t-ui) var(--ease);
  }
  .breaker {
    position: absolute;
    left: -9px;
    top: 18px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--feed);
    background: var(--paper);
    border-radius: 2px;
    transition: border-color var(--t-ui) var(--ease);
  }
  .breaker i {
    position: absolute;
    left: 5px;
    top: -9px;
    width: 2px;
    height: 16px;
    background: var(--feed);
    transform-origin: bottom center;
    transform: rotate(-38deg);
    transition: transform var(--t-page) var(--ease-settle), background-color var(--t-ui) var(--ease);
  }
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 16px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    transition: border-color var(--t-ui) var(--ease), transform var(--t-ui) var(--ease), box-shadow var(--t-ui) var(--ease);
  }
  .idx {
    font-size: 0.72rem;
    color: var(--ink-2);
  }
  .title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .line {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .meta {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--signal);
  }
  .arrow {
    transition: transform var(--t-ui) var(--ease);
  }
  .feeder:hover .drop,
  .feeder:focus-visible .drop {
    border-color: var(--sun);
  }
  .feeder:hover .drop::before,
  .feeder:focus-visible .drop::before {
    opacity: 1;
  }
  .feeder:hover .breaker,
  .feeder:focus-visible .breaker {
    border-color: var(--sun);
  }
  .feeder:hover .breaker i,
  .feeder:focus-visible .breaker i {
    transform: rotate(0deg);
    background: var(--sun);
  }
  .feeder:hover .card,
  .feeder:focus-visible .card {
    border-color: var(--signal);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .feeder:hover .arrow,
  .feeder:focus-visible .arrow {
    transform: translateX(4px);
  }
  .feeder:focus-visible {
    outline: none;
  }
  .feeder:focus-visible .card {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .drop::before {
      animation: current 0.9s linear infinite;
      animation-play-state: paused;
    }
    .feeder:hover .drop::before,
    .feeder:focus-visible .drop::before {
      animation-play-state: running;
    }
  }
  @keyframes current {
    to {
      background-position: 0 14px;
    }
  }

  /* Vertical bus on narrow screens: feeders run to the right. */
  @media (max-width: 959px) {
    .sld {
      grid-template-columns: 1fr;
    }
    .source {
      padding: 0 0 6px;
    }
    .source span {
      bottom: auto;
      top: 16px;
    }
    .bus {
      grid-row: 2;
      grid-column: 1;
      justify-self: start;
      align-self: stretch;
      width: 4px;
      height: auto;
      margin: 0 0 30px 22px;
    }
    ul {
      grid-row: 2;
      grid-column: 1;
      grid-template-columns: 1fr;
      gap: 12px;
      padding-left: 24px;
    }
    .feeder {
      flex-direction: row;
      align-items: stretch;
    }
    .drop {
      height: auto;
      width: 44px;
      flex: none;
      margin: 0;
      border-left: 0;
      border-top: 2px solid var(--feed);
      align-self: center;
    }
    .drop::before {
      left: 0;
      top: -2px;
      width: 100%;
      height: 2px;
      background: repeating-linear-gradient(to right, var(--sun) 0 6px, transparent 6px 14px);
    }
    .breaker {
      left: 14px;
      top: -9px;
    }
    .breaker i {
      left: 5px;
      top: -9px;
    }
    @keyframes current {
      to {
        background-position: 14px 0;
      }
    }
  }
</style>
