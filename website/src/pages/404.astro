---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---

<Base title="Page not found" description="This page does not exist.">
  <section class="wrap oc">
    <svg class="diagram" viewBox="0 0 520 120" aria-hidden="true">
      <circle cx="40" cy="60" r="26" />
      <path class="sine" d="M24 60c5-13 10-13 16 0s11 13 16 0" />
      <path d="M66 60H230" />
      <path class="open" d="M230 60 L282 30" />
      <circle cx="230" cy="60" r="4" class="pt" />
      <circle cx="290" cy="60" r="4" class="pt" />
      <path d="M290 60H470" />
      <path d="M470 36v48M482 46v28M494 54v12" />
    </svg>
    <p class="label">Error 404 · Open circuit</p>
    <h1 class="serif">This page isn't connected.</h1>
    <p class="muted">The link may be old, or the page has moved. Close the breaker and head back.</p>
    <div class="actions">
      <a class="btn primary" href={url()}>Back to home</a>
      <button class="btn" type="button" data-cmdk-open>Search the site <span class="kbd" data-kbd>Ctrl K</span></button>
    </div>
  </section>
</Base>

<style>
  .oc {
    padding-block: clamp(56px, 10vw, 120px);
    max-width: 760px;
  }
  .diagram {
    width: min(100%, 520px);
    margin-bottom: 32px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .diagram .sine {
    stroke: var(--signal);
  }
  .diagram .open {
    stroke: var(--sun);
    stroke-width: 3;
  }
  .diagram .pt {
    fill: var(--paper);
  }
  h1 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.4rem);
    font-weight: 400;
    line-height: 1.02;
    margin: 12px 0 16px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
</style>
