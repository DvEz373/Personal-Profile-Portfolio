---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects, CATEGORY_LABEL, THEMES, TONE } from "../../lib/content";

const projects = await getProjects();
const keysOf = (p: (typeof projects)[number]) => [p.data.category, ...p.data.also];
const cats = THEMES.map((k) => ({ key: k, label: CATEGORY_LABEL[k], tone: TONE[k], n: projects.filter((p) => keysOf(p).includes(k)).length }));
const groups = [
  { id: "client-work", title: "Client work", note: "Power system models and studies delivered for utilities, plant owners and manufacturers.", items: projects.filter((p) => p.data.kind === "professional") },
  { id: "academic", title: "Academic and personal", note: "Thesis, capstone and lab projects from Universitas Indonesia.", items: projects.filter((p) => p.data.kind === "academic") },
].filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Projects by Devin Ezekiel Purba: power plant controllers, generator and synchronous condenser models, grid compliance studies and an AI fault locator, plus multi-agent reinforcement learning, IoT and computer-vision projects.">
  <PageHead index="03" eyebrow="Projects" title="Projects" intro="Client studies in power systems, and the AI and IoT projects that led to them. Open one for the problem, approach, result and figures." art="circuit" />

  <section class="wrap" data-filterable>
    <div class="bar">
      <div class="chips" role="group" aria-label="Filter projects by theme">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All<span class="count">{projects.length}</span></button>
        {
          cats.map((c) => (
            <button class:list={["chip", c.tone]} type="button" data-filter={c.key} aria-pressed="false">
              <i class="dot" aria-hidden="true" />
              {c.label}
              <span class="count">{c.n}</span>
            </button>
          ))
        }
      </div>
      <p class="label" aria-live="polite" data-shown>Showing {projects.length} of {projects.length}</p>
    </div>

    {
      groups.map((g) => (
        <section class="group" aria-labelledby={`h-${g.id}`}>
          <h2 id={`h-${g.id}`}>{g.title}</h2>
          <p class="note">{g.note}</p>
          <ul class="grid">
            {g.items.map((p) => (
              <li data-kind={keysOf(p).join(" ")} class={TONE[p.data.category]}>
                <ProjectCard entry={p} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-bottom: 28px;
  }
  .bar .label {
    margin: 0;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .grid li[hidden] {
    display: none;
  }
  .group + .group {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .group h2 {
    font-size: var(--step-2);
    margin: 0 0 4px;
  }
  .group .note {
    margin: 0 0 20px;
    color: var(--ink-2);
  }
  /* A filter can empty a group; hide its heading too. */
  .group:not(:has(li:not([hidden]))) {
    display: none;
  }
</style>

<script>
  import { initFilterablePage } from "../../scripts/filters";
  document.addEventListener("astro:page-load", initFilterablePage);
</script>
