---
import { render } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ProjectCover from "../../components/ProjectCover.astro";
import Schematic from "../../components/Schematic.astro";
import Icon from "../../components/Icon.astro";
import { getProjects, CATEGORY_LABEL, KIND_LABEL_PROJECT, TONE, DOMAIN } from "../../lib/content";
import { formatDuration, formatRange } from "../../lib/dates";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const [cover, ...more] = p.figures;
const art = { energy: "grid", ai: "neural", iot: "circuit" } as const;
---

<Base title={p.title} description={`${p.title}: ${p.blurb}`}>
  <article class:list={["project", TONE[p.category]]}>
    <header class="head">
      <div class="wrap">
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a href={url("projects/")}>Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{p.title}</span>
        </nav>
        <p class="label cat">{KIND_LABEL_PROJECT[p.kind]} · {CATEGORY_LABEL[p.category]}</p>
        <h1 transition:name={`title-${entry.id}`}>{p.title}</h1>
        <p class="blurb">{p.blurb}</p>
        {
          p.role && (
            <p class="role">
              <strong>My part:</strong> {p.role}
            </p>
          )
        }
      </div>
      {!cover && <Schematic variant={art[DOMAIN[p.category]]} />}
    </header>

    <div class="wrap layout">
      <figure class="lead">
        <div class:list={["figure", { wide: cover && cover.src.width / cover.src.height > 2.2 }]} transition:name={`fig-${entry.id}`}>
          <ProjectCover id={entry.id} category={p.category} figure={cover} sizes="(min-width: 960px) 760px, 100vw" eager />
        </div>
        {
          cover && (
            <figcaption>
              {cover.caption}{" "}
              <a href={cover.src.src} target="_blank" rel="noopener">
                Full size<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </figcaption>
          )
        }
      </figure>

      <aside class="spec" aria-label="Project details">
        <p class="label">Datasheet</p>
        <dl>
          {
            p.role && (
              <div>
                <dt>My part</dt>
                <dd>{p.role}</dd>
              </div>
            )
          }
          <div><dt>Context</dt><dd>{p.context}</dd></div>
          <div>
            <dt>Period</dt>
            <dd>
              {formatRange(p.start, p.end)}
              {p.end && <span class="muted"> · {formatDuration(p.start, p.end)}</span>}
            </dd>
          </div>
          <div>
            <dt>Stack</dt>
            <dd class="stack">{p.stack.map((s) => <span class="tag">{s}</span>)}</dd>
          </div>
          {
            p.links.length > 0 && (
              <div>
                <dt>Links</dt>
                <dd class="links">
                  {p.links.map((l) => (
                    <a href={l.href} rel="noopener">
                      {l.label} <Icon name="arrow-up-right" size={14} />
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
        {
          p.facts.length > 0 && (
            <>
              <p class="label facts-h">Key facts</p>
              <dl class="facts">
                {p.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            </>
          )
        }
      </aside>

      <div class="story">
        <section aria-labelledby="h-problem">
          <h2 id="h-problem">Problem</h2>
          <p>{p.problem}</p>
        </section>
        <section aria-labelledby="h-approach">
          <h2 id="h-approach">Approach</h2>
          <p>{p.approach}</p>
        </section>
        <section aria-labelledby="h-result">
          <h2 id="h-result">Result</h2>
          <p>{p.result}</p>
        </section>
        <div class="prose">
          <Content />
        </div>
      </div>

      {
        more.length > 0 && (
          <section aria-labelledby="h-figs" class="figs">
            <h2 id="h-figs">Figures</h2>
            {more.map((f) => (
              <figure>
                <a class="sheet" href={f.src.src} target="_blank" rel="noopener">
                  <Picture
                    src={f.src}
                    alt={f.alt}
                    formats={["avif", "webp"]}
                    widths={[480, 800, 1200, 1600].filter((w) => w <= f.src.width)}
                    sizes="(min-width: 1240px) 1160px, 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="visually-hidden"> (full size, opens in a new tab)</span>
                </a>
                <figcaption>{f.caption}</figcaption>
              </figure>
            ))}
          </section>
        )
      }
    </div>

    <nav class="wrap pager" aria-label="More projects">
      {
        prev ? (
          <a href={url(`projects/${prev.id}/`)} class="prev">
            <span class="label">← Previous</span>
            <span class="t">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={url(`projects/${next.id}/`)} class="next">
            <span class="label">Next →</span>
            <span class="t">{next.data.title}</span>
          </a>
        ) : (
          <a href={url("projects/")} class="next">
            <span class="label">All projects →</span>
            <span class="t">Back to the list</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(28px, 5vw, 56px) clamp(24px, 4vw, 40px);
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--ink-2);
    margin-bottom: 22px;
  }
  .crumbs a {
    color: var(--ink-2);
  }
  .cat {
    color: var(--c-ink);
  }
  h1 {
    max-width: 22ch;
    font-size: clamp(2.2rem, 1.4rem + 3.2vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 10px 0 14px;
    text-wrap: balance;
  }
  .blurb {
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
    margin: 0;
  }
  .role {
    max-width: 62ch;
    margin: 14px 0 0;
    color: var(--ink-2);
  }
  .role strong {
    color: var(--ink);
    font-weight: 600;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 28px 40px;
    align-items: start;
  }
  .lead {
    grid-column: 1;
    margin: 0;
  }
  .figure {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  /* Long pipeline diagrams would shrink to unreadable in a 16:9 box. */
  .figure.wide {
    aspect-ratio: auto;
  }
  .lead figcaption,
  .figs figcaption {
    margin-top: 10px;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .spec {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: sticky;
    top: calc(var(--header-h) + 20px);
    padding: 18px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--c);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .spec dl {
    margin: 10px 0 0;
  }
  .spec dl > div {
    padding: 10px 0;
    border-top: 1px dashed var(--line);
  }
  .spec dt {
    font-family: var(--font-sans), system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .spec dd {
    margin: 4px 0 0;
  }
  .facts-h {
    margin: 18px 0 0;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .links {
    display: grid;
    gap: 4px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .story {
    grid-column: 1;
    max-width: 68ch;
  }
  .story section {
    position: relative;
    padding: 22px 0 6px;
    border-top: 1px solid var(--line);
  }
  .story h2 {
    font-size: var(--step-1);
    margin-bottom: 8px;
  }
  .prose {
    color: var(--ink-2);
  }
  .prose :global(p) {
    margin: 12px 0;
  }
  .prose :global(h2) {
    padding-top: 22px;
    border-top: 1px solid var(--line);
    margin: 22px 0 8px;
    font-size: var(--step-1);
    color: var(--ink);
  }
  .prose :global(ol),
  .prose :global(ul) {
    margin: 12px 0;
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin: 8px 0;
    padding-left: 4px;
  }
  .prose :global(li::marker) {
    color: var(--c-ink);
    font-weight: 600;
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  /* Figures run the full width of the page so wide diagrams stay legible. */
  .figs {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(24px, 4vw, 40px);
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .figs h2 {
    font-size: var(--step-1);
    margin: 0;
  }
  .figs figure {
    margin: 0;
  }
  .sheet {
    display: block;
    padding: clamp(10px, 2vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: #fff;
    transition: border-color var(--t-ui) var(--ease);
  }
  .sheet:hover {
    border-color: var(--signal);
  }
  .sheet :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--t-ui) var(--ease);
  }
  .pager a:hover {
    border-color: var(--signal);
  }
  .pager .next {
    text-align: right;
  }
  .pager .t {
    font-size: 1.5rem;
    line-height: 1.1;
  }
  @media (max-width: 959px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .spec {
      grid-column: 1;
      grid-row: auto;
      position: static;
    }
  }
  @media (max-width: 559px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
