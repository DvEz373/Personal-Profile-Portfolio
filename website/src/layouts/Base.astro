---
import { ClientRouter } from "astro:transitions";
import { pageAnimation } from "../lib/transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { getProfile } from "../lib/content";
import { url } from "../lib/url";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  /** Path of the Open Graph image inside /public. */
  image?: string;
}

const { title, description, image = "og.jpg" } = Astro.props;
const profile = await getProfile();
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}, ${profile.headlineAccent}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}: ${profile.headline}, ${profile.headlineAccent}`} />
    <meta property="profile:first_name" content={profile.givenNames} />
    <meta property="profile:last_name" content={profile.familyName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0f14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      // Set the theme before first paint, and again after each client-side navigation.
      (function () {
        function apply() {
          var t = null;
          try { t = localStorage.getItem("theme"); } catch (e) {}
          if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        }
        apply();
        if (!window.__themeHooked) {
          window.__themeHooked = true;
          document.addEventListener("astro:after-swap", apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" transition:name="main" transition:animate={pageAnimation}>
      <slot />
    </main>
    <Footer profile={profile} />
    <CommandPalette />
    <div class="toast mono" role="status" aria-live="polite" data-toast></div>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: var(--radius-s);
    background: var(--signal);
    color: var(--signal-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 90;
    translate: -50% 16px;
    padding: 10px 16px;
    border-radius: var(--radius-s);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--t-ui) var(--ease),
      translate var(--t-ui) var(--ease);
  }
  .toast.show {
    opacity: 1;
    translate: -50% 0;
  }
</style>

<script>
  import { initShell } from "../scripts/shell";
  document.addEventListener("astro:page-load", initShell);
</script>
